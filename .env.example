# Development-only values. Use a secret manager and TLS in shared environments.
AGENTTRACE_API_KEY=replace-me
# Optional for clients exporting directly to an authenticated OTLP endpoint.
# Keep this collector credential separate from every model-provider credential.
# AGENTTRACE_OTLP_HEADERS=X-AgentTrace-Key=replace-me
MINIO_ROOT_USER=agenttrace
MINIO_ROOT_PASSWORD=replace-me-with-at-least-16-characters
POSTGRES_USER=agenttrace
POSTGRES_PASSWORD=replace-me
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-me

# Model credentials are runtime-only. Prefer a mounted file in containers.
# Never place the actual value in this file.
ZAI_API_KEY_FILE=/run/secrets/zai_api_key
ZAI_MODEL=glm-5.2
ZAI_THINKING_MODE=disabled
ZAI_REASONING_EFFORT=max

# Optional host-port overrides for machines where defaults are already occupied.
AGENTTRACE_HTTP_PORT=8000
OTEL_GRPC_PORT=4317
OTEL_HTTP_PORT=4318
OTEL_HEALTH_PORT=13133
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
POSTGRES_PORT=5432
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
PHOENIX_PORT=6006
